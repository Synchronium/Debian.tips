// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Debian.tips (Node/TS)",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// Lets the example replay run inside throwaway `docker run --rm` containers rather than
		// directly in this persistent devcontainer, so the packages and services a page needs to
		// be verified (openssh-server, a running sshd) don't accumulate here.
		// Needs "privileged": true below, without which nested Docker won't start.
		// moby:false because the default moby-cli/moby-engine packages aren't published
		// for Debian trixie yet; this makes the feature install real docker-ce instead.
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"moby": false
		},
		// The GitHub CLI, for reading CI results from in here. Fetching a failing job's log needs
		// authentication, since the anonymous API returns 403 for it, so without `gh` the only way
		// to see why a run failed is to paste it in by hand. It isn't in Debian's repositories, so
		// this feature (upstream apt repo) rather than postCreateCommand.
		"ghcr.io/devcontainers/features/github-cli:1.1.1": {}
	},
	"privileged": true,

	// Both directories would otherwise live on the container's own writable layer, which a
	// rebuild discards along with everything in it: ~/.claude holds Claude Code's session
	// transcripts, memory and config, and ~/.config/gh holds what `gh auth login` wrote, so
	// without the volume that login has to be repeated after every rebuild.
	"mounts": [
		"source=debiantips-claude-home,target=/home/node/.claude,type=volume",
		"source=debiantips-gh-config,target=/home/node/.config/gh,type=volume"
	],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Two things, in the order the command does them.
	//
	// Both volumes above are created owned by root on first mount, which leaves the node user
	// unable to write to them. They are chowned back before anything else touches them.
	//
	// Then the real `chromium` apt package, which pa11y-ci and any local Lighthouse run drive
	// headlessly; containerEnv below points Puppeteer at it and skips Puppeteer's own separate
	// "Chrome for Testing" download. That works here because the container permits ptrace, which
	// chromium's crashpad self-test needs to launch at all. Where a sandbox forbids it, that test
	// crashes with SIGTRAP and Puppeteer's own build is the way back. CI runs outside this
	// devcontainer, on GitHub's runners, and downloads its own Chrome there.
	"postCreateCommand": "sudo mkdir -p /home/node/.claude /home/node/.config/gh && sudo chown -R node:node /home/node/.claude /home/node/.config/gh && sudo apt-get update && sudo apt-get install -y chromium",

	"containerEnv": {
		"PUPPETEER_SKIP_DOWNLOAD": "true",
		"PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code",
				"github.vscode-github-actions"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
