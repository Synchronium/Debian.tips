// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// Lets Claude run content-example testing batches inside throwaway `docker run --rm`
		// containers instead of directly in this persistent devcontainer, so installs/service
		// state from testing (e.g. openssh-server, a spun-up sshd) don't accumulate here.
		// Needs "privileged": true below — nested Docker won't start without it.
		// moby:false because the default moby-cli/moby-engine packages aren't published
		// for Debian trixie yet; this makes the feature install real docker-ce instead.
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		}
	},
	"privileged": true,

	// Persists Claude Code session transcripts, memory, and config across container rebuilds.
	// Without this, ~/.claude lives on the container's own writable layer and is discarded on
	// every rebuild along with everything in it.
	"mounts": [
		"source=debiantips-claude-home,target=/home/node/.claude,type=volume"
	],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Installs the OS-level shared libraries (libnss3, libatk-bridge2.0-0, libgtk-3-0, etc.)
	// headless Chrome needs to run at all — pa11y-ci and any local Lighthouse run (accessibility/
	// perf checks) depend on this. Deliberately does NOT install the `chromium` apt package
	// itself: in some sandboxed environments its crashpad self-test crashes with SIGTRAP on
	// launch (a ptrace restriction — --cap-add=SYS_PTRACE was tried and did not help). Puppeteer's
	// own downloaded "Chrome for Testing" build (already a transitive dependency via pa11y-ci)
	// works fine given just these libraries, so leave PUPPETEER_SKIP_DOWNLOAD /
	// PUPPETEER_EXECUTABLE_PATH unset and let `npm install`'s postinstall step fetch one
	// normally. See PLAN-BUILD.md §7.1 for the full story.
	// The debiantips-claude-home volume above is created and owned by root on first mount, which
	// blocks the node user (and thus the Claude Code extension / CLI) from writing to
	// ~/.claude — chown it back to node before anything else touches it.
	"postCreateCommand": "sudo mkdir -p /home/node/.claude && sudo chown -R node:node /home/node/.claude && sudo apt-get update && npx --yes playwright install-deps chromium",

	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code"
			]
		}
	},

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
