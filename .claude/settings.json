{
  "permissions": {
    "allow": [
      "Bash(npm run check*)",
      "Bash(scripts/sandbox.sh *)",
      "Edit(content/**)",
      "Write(content/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx scripts/voice-check.ts --hook"
          }
        ]
      }
    ]
  }
}
