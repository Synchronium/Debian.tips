{
  "name": "debian.tips",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsx src/build.ts && pagefind --site dist",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "replay": "tsx scripts/replay-all.ts",
    "audit:links": "tsx scripts/link-audit.ts",
    "check": "NODE_ENV=production npm run check:gate",
    "check:gate": "npm run format:check && tsc --noEmit && tsc -p tsconfig.client.json && vitest run && tsx src/build.ts && pagefind --site dist && tsx src/linkcheck.ts && tsx scripts/link-audit.ts",
    "format": "prettier --write \"src/**/*.ts\" \"src/client/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"styles/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/client/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"styles/**/*.css\""
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "pa11y-ci": "^4.1.1",
    "pagefind": "^1.3.0",
    "prettier": "^3.9.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "serve": "^14.2.6",
    "shiki": "^4.4.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  }
}
